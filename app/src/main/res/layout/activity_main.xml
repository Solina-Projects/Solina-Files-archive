<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Top navigation row: drawer, history and current folder/path -->
    <LinearLayout
        android:id="@+id/navigationBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layoutDirection="rtl"
        android:elevation="2dp"
        android:background="?attr/colorSurface">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/drawerButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:padding="0dp"
            android:contentDescription="منوی کناری"
            app:icon="@drawable/ic_menu"
            app:iconTint="?attr/colorOnSurface"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:padding="0dp"
            android:contentDescription="بازگشت"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="?attr/colorOnSurface"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navForward"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:padding="0dp"
            android:contentDescription="جلو رفتن"
            app:icon="@drawable/ic_arrow_forward"
            app:iconTint="?attr/colorOnSurface"
            app:iconPadding="0dp" />

        <TextView
            android:id="@+id/pathView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:scrollHorizontally="true"
            android:ellipsize="none"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="?attr/colorOnSurface"
            android:textDirection="ltr"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overflowButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:padding="0dp"
            android:contentDescription="گزینه‌های بیشتر"
            app:icon="@drawable/ic_more_vert"
            app:iconTint="?attr/colorOnSurface"
            app:iconPadding="0dp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/storageQuickBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />
    </HorizontalScrollView>

    <!-- Second toolbar row: actions on a contrasting surface -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="?attr/colorSurfaceContainer"
        android:elevation="1dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/searchIconButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:backgroundTint="?attr/colorPrimaryContainer"
            android:contentDescription="رفتن به جست‌وجو"
            app:icon="@drawable/ic_search"
            app:iconTint="?attr/colorOnPrimaryContainer"
            app:iconPadding="0dp" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/search_field_bg"
            android:textColor="?attr/colorOnSurface"
            android:hintTextColor="?attr/colorOnSurfaceVariant"
            android:hint="جست‌وجو"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sortFilterButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:padding="0dp"
            android:contentDescription="مرتب‌سازی و فیلتر"
            app:icon="@drawable/ic_sort"
            app:iconTint="?attr/colorOnSecondaryContainer"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/layoutModeButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:padding="0dp"
            android:contentDescription="چیدمان پوشه‌ها و فایل‌ها"
            app:icon="@drawable/ic_grid_view"
            app:iconTint="?attr/colorOnSecondaryContainer"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dualPaneButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:padding="0dp"
            android:contentDescription="حالت دو پنجره‌ای"
            app:icon="@drawable/ic_splitscreen"
            app:iconTint="?attr/colorOnSecondaryContainer"
            app:iconPadding="0dp" />

    </LinearLayout>



    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/mainBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/storageButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                app:icon="@drawable/ic_arrow_drop_down"
                app:iconGravity="textEnd"
                app:iconTint="?attr/colorOnSurface" />
        </com.google.android.material.appbar.MaterialToolbar>

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/selectionBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurfaceContainerHigh"
            android:visibility="gone"
            app:navigationIcon="@drawable/ic_close" />
    </FrameLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="104dp" />

        <LinearLayout
            android:id="@+id/emptyBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grantButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/grant_access"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/pasteFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:text="@string/paste_here"
            android:visibility="gone"
            app:icon="@drawable/ic_content_paste" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bottomCopy"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="کپی" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bottomMove"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="انتقال" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bottomDelete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="حذف" />
    </LinearLayout>
</LinearLayout>